# Environment Configuration
# Copy this file to .env and fill in your actual values

# Microsoft Foundry Project Endpoint
# In VS Code, Foundry Toolkit > right-click your active project > Copy Project Endpoint,
# or copy it from the Microsoft Foundry portal project overview page.
PROJECT_ENDPOINT=your_project_endpoint_here

# The name of your deployed model (for example, gpt-4o) - used by every task
MODEL_DEPLOYMENT_NAME=your_model_deployment_name_here

# The grounded knowledge agent Task 2 and Task 3 evaluate.
# Bring one from Lab B, or run: python ../setup/bootstrap_agent.py
AGENT_NAME=caldova-knowledge-agent

# Task 2 only: the Azure OpenAI endpoint the evaluator model runs on.
# Leave this blank and the lab derives it from PROJECT_ENDPOINT
# (https://<your-resource>.services.ai.azure.com).
AZURE_OPENAI_ENDPOINT=

# Task 2 only: API version used by the evaluator model.
AZURE_OPENAI_API_VERSION=2024-10-21
